---
import AdminLayout from '@/components/AdminLayout.astro';
import { loadReports } from '@/lib/data';
import { formatMoney } from '@/lib/dates';
const filter = Astro.url.searchParams.get('filter') ?? 'monthly';
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const data = await loadReports(Astro.locals.supabase, filter, from, to);
---
<AdminLayout title="Reports">
  <section class="panel stack">
    <div class="section-heading"><div><h1>Reports</h1><p class="muted">Production and sales activity</p></div><div class="no-print"><a class="button" href={`/api/reports.csv?filter=${encodeURIComponent(filter)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`}>Export CSV</a> <button id="print-report" type="button">Print / Save PDF</button></div></div>
    <form class="filters no-print" method="get">
      <label>Period<select name="filter"><option value="weekly" selected={filter === 'weekly'}>Last 7 days</option><option value="monthly" selected={filter === 'monthly'}>This month</option><option value="range" selected={filter === 'range'}>Date range</option><option value="all" selected={filter === 'all'}>All time</option></select></label>
      <label>From<input type="date" name="from" value={from} /></label><label>To<input type="date" name="to" value={to} /></label><button>Apply</button>
    </form>
    <div class="stats"><article class="stat-card">Production<strong>{data.totalProduction.toFixed(2)} KG</strong></article><article class="stat-card">Sales<strong>{data.totalSales.toFixed(2)} KG</strong></article><article class="stat-card">Revenue<strong>{formatMoney(data.totalRevenue)}</strong></article></div>
    <h2>Production</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>KG</th><th>Eggs</th><th>Feed (KG)</th><th>Condition</th></tr></thead><tbody>
      {data.production.map((row) => <tr><td>{row.tanggal}</td><td>{row.jumlah_kg}</td><td>{row.jumlah_butir}</td><td>{row.pakan_kg}</td><td>{row.kondisi_ayam}</td></tr>)}
    </tbody></table></div>
    <h2>Sales</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Buyer</th><th>Product</th><th>KG</th><th>Total</th></tr></thead><tbody>
      {data.sales.map((row) => <tr><td>{row.tanggal}</td><td>{row.nama_pembeli}</td><td>{row.produk}</td><td>{row.jumlah_kg}</td><td>{formatMoney(row.total_harga)}</td></tr>)}
    </tbody></table></div>
  </section>
  <script>
    document.querySelector('#print-report')?.addEventListener('click', () => window.print());
  </script>
</AdminLayout>
