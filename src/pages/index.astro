---
import BaseLayout from '@/components/BaseLayout.astro';
import { queryAll, type PriceRecord, type ProductRecord } from '@/lib/data';
import { businessDate, formatMoney } from '@/lib/dates';
import { units } from '@/lib/sales';

const products = await queryAll<ProductRecord>((from, to) => Astro.locals.supabase
  .from('produk').select('*').order('id_produk').range(from, to));
const prices = await queryAll<PriceRecord>((from, to) => Astro.locals.supabase.from('harga').select('*')
  .lte('tanggal_berlaku', businessDate())
  .order('tanggal_berlaku', { ascending: false }).order('id_harga', { ascending: false }).range(from, to));
const latestPrices = new Map<string, number>();
const latestPriceDates = new Map<string, string>();
for (const price of prices) {
  if (latestPrices.has(price.produk)) continue;
  latestPrices.set(price.produk, Number(price.harga));
  latestPriceDates.set(price.produk, price.tanggal_berlaku);
}
const formatPriceDate = (value: string) => new Intl.DateTimeFormat('en-MY', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${value}T00:00:00Z`));
const success = Astro.url.searchParams.get('success');
---
<BaseLayout title="Fresh farm eggs">
  <div class="public-site">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="announcement-bar">
      <span class="announcement-dot" aria-hidden="true"></span>
      Fresh from our farm, thoughtfully brought to your table
    </div>
    <div class="site-header-wrap">
      <header class="site-header">
        <a class="site-brand" href="/" aria-label="Yong Farm home">
          <img src="https://x3n99.github.io/logotelur.png" alt="" width="64" height="64" />
          <span>Yong Farm<small>GOOD FOOD, GROWN WITH CARE</small></span>
        </a>
        <button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav">
          <span></span>
        </button>
        <nav class="site-nav" id="main-nav" aria-label="Main navigation">
          <a href="#farm">Our farm</a>
          <a href="#products">Our eggs</a>
          <a href="#order">How to order</a>
          <a class="button" href="#order">Order fresh eggs <span class="button-arrow" aria-hidden="true">↗</span></a>
        </nav>
      </header>
    </div>

    {success && <p class="notice section" role="status">{success}</p>}

    <main id="main-content" tabindex="-1">
      <section class="hero-section">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-mark"></span> A little closer to the farm</p>
          <h1 class="hero-title">Good eggs.<br /><em>Good from the start.</em></h1>
          <p class="hero-lede">We raise, gather and carefully select our eggs with one simple thought: good food should feel good, all the way home.</p>
          <div class="hero-actions">
            <a class="button" href="#products">Meet our eggs <span class="button-arrow" aria-hidden="true">↗</span></a>
            <a class="button button-light" href="#farm">Our farm story</a>
          </div>
          <div class="hero-caption"><span class="caption-seal" aria-hidden="true">Y</span> Thoughtfully raised. Carefully gathered. Ready for your table.</div>
        </div>
        <div class="hero-visual">
          <img src="https://x3n99.github.io/logotelur.png" alt="Illustration of a farm and freshly gathered eggs" width="960" height="760" fetchpriority="high" />
          <div class="hero-note"><strong>From our farm</strong><span>Made with care, from the first morning gathering to your kitchen.</span></div>
        </div>
      </section>

      <div class="quality-strip" aria-label="Our values">
        <div class="quality-inner">
          <div class="quality-item" data-reveal><span class="quality-icon" aria-hidden="true">✳</span> Carefully gathered</div>
          <div class="quality-item" data-reveal><span class="quality-icon" aria-hidden="true">⌁</span> Quality selected</div>
          <div class="quality-item" data-reveal><span class="quality-icon" aria-hidden="true">♡</span> Farm to your table</div>
        </div>
      </div>

      <section class="section story-section" id="farm">
        <div class="story-card" data-reveal>
          <div class="story-art" aria-hidden="true"><img src="https://x3n99.github.io/logotelur.png" alt="" width="600" height="440" loading="lazy" decoding="async" /></div>
          <div class="story-copy">
            <p class="eyebrow"><span class="eyebrow-mark"></span> Our way of farming</p>
            <h2>Care you can taste.<br /><em>Quality you can trust.</em></h2>
            <p>Every egg begins with the care we give our flock and the attention we bring to each harvest. We keep things thoughtful, handle each order with care, and make it easy to enjoy farm-fresh eggs at home.</p>
            <ul class="story-list">
              <li>Farm-raised with care</li>
              <li>Selected for quality</li>
              <li>Made for everyday meals</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="section" id="products" aria-labelledby="products-heading">
        <div class="section-heading" data-reveal>
          <div>
            <p class="eyebrow"><span class="eyebrow-mark"></span> From our farm to your table</p>
            <h2 id="products-heading">Find your farm favourite.</h2>
          </div>
          <p class="muted">A little something for breakfast, baking and all the good meals in between.</p>
        </div>
        {products.length > 0 ? (
          <div class="product-grid">
            {products.map((product) => (
              <article class="product-card" data-reveal>
                <div class="product-art">
                  <span class="product-label">From our collection</span>
                  <img
                    src={product.image || '/img/egg-art.svg'}
                    data-image-fallback="/img/egg-art.svg"
                    alt={`${product.nama} eggs`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="product-info">
                  <h3>{product.nama}</h3>
                  {product.deskripsi && <p>{product.deskripsi}</p>}
                  {latestPrices.has(product.nama) ? (
                    <>
                      <div class="product-prices">
                        <div><span>Per egg</span><strong>{formatMoney(latestPrices.get(product.nama)!)}</strong></div>
                        <div><span>Tray · 30 eggs</span><strong>{formatMoney(latestPrices.get(product.nama)! * units.tray)}</strong></div>
                      </div>
                      <p class="price-effective">Effective {formatPriceDate(latestPriceDates.get(product.nama)!)}</p>
                    </>
                  ) : <p class="price-effective">Ask us for today’s price.</p>}
                  <a class="product-order-link" href="#order" data-order-product={product.nama}>
                    Order this product <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-products">Our farm favourites are being prepared. Please check back soon.</p>
        )}
      </section>

      <section class="order-section" id="order">
        <div class="order-inner">
          <div class="order-copy" data-reveal>
            <p class="eyebrow"><span class="eyebrow-mark"></span> A fresh order, made simple</p>
            <h2>Good things are just an order away.</h2>
            <p>Tell us what you need and our team will be in touch to confirm availability, delivery and today’s details.</p>
            <ol class="order-steps" aria-label="What happens after you send an order request">
              <li><span aria-hidden="true">01</span><div><strong>Send your request</strong><small>Choose your eggs and share the delivery address.</small></div></li>
              <li><span aria-hidden="true">02</span><div><strong>We confirm the details</strong><small>Our team checks availability, final price and delivery.</small></div></li>
              <li><span aria-hidden="true">03</span><div><strong>We arrange the order</strong><small>We’ll contact you with the next steps.</small></div></li>
            </ol>
            <a class="order-contact" href="https://wa.me/60123456789" target="_blank" rel="noopener noreferrer">
              Questions before ordering? Chat with our team <span aria-hidden="true">↗</span>
            </a>
          </div>
          <form class="order-card order-form" method="post" action="/api/actions" aria-labelledby="order-form-heading" data-reveal>
            <div class="wide">
              <h3 id="order-form-heading">Place an order</h3>
              <p>Share a few details and we’ll take it from there.</p>
            </div>
            <input type="hidden" name="action" value="order_create" />
            <label>Name<input name="nama" maxlength="150" autocomplete="name" placeholder="Your name" required /></label>
            <label>Phone<input name="no_hp" maxlength="50" type="tel" autocomplete="tel" placeholder="Best number to reach you" required /></label>
            <label>Product<select id="order-product" name="produk" required>{products.map((product) => <option value={product.nama} data-price={latestPrices.get(product.nama) ?? ''}>{product.nama}</option>)}</select></label>
            <label>Quantity<input id="order-quantity" name="jumlah" type="number" min="1" step="1" value="1" required /></label>
            <label>Pack size<select id="order-unit" name="satuan"><option value="butir" data-eggs={units.butir} data-unit-label="egg">Individual egg</option><option value="pack_10" data-eggs={units.pack_10} data-unit-label="pack">Pack of 10</option><option value="pack_12" data-eggs={units.pack_12} data-unit-label="pack">Pack of 12</option><option value="tray" data-eggs={units.tray} data-unit-label="tray">Tray of 30</option><option value="crate" data-eggs={units.crate} data-unit-label="crate">Crate of 360</option></select></label>
            <label class="wide">Delivery address<textarea name="alamat" rows="2" maxlength="2000" autocomplete="street-address" placeholder="Where should we deliver?" required></textarea></label>
            <label class="wide">Anything else? <span class="muted">(optional)</span><textarea name="pesan" rows="2" maxlength="2000" placeholder="Add a note for our team"></textarea></label>
            <div class="price-estimate wide" aria-live="polite" aria-atomic="true">
              <div><span>Estimated subtotal</span><strong id="order-estimate">—</strong></div>
              <p id="order-estimate-details">Choose a product and pack size to preview the total.</p>
              <small>Estimate covers eggs only. We’ll confirm availability, delivery fee and final price.</small>
            </div>
            <p class="order-privacy wide">We use your details to respond to this request. <a href="/privacy">Read our privacy notice</a>.</p>
            <button class="wide" type="submit">Send order request <span class="button-arrow" aria-hidden="true">↗</span></button>
          </form>
        </div>
      </section>
    </main>

    <footer class="public-footer">
      <div class="footer-inner">
        <div class="footer-main">
          <div class="footer-about" data-reveal>
            <a class="site-brand footer-brand" href="/">
              <img src="https://x3n99.github.io/logotelur.png" alt="" width="64" height="64" />
              <span>Yong Farm<small>GOOD FOOD, GROWN WITH CARE</small></span>
            </a>
            <p>Thoughtfully raised and carefully selected eggs, from our farm to your family table.</p>
          </div>
          <div class="footer-column" data-reveal>
            <h2>Explore</h2>
            <nav class="footer-links" aria-label="Footer navigation">
              <a href="#farm">Our farm</a>
              <a href="#products">Our eggs</a>
              <a href="#order">Place an order</a>
              <a href="/delivery">Delivery &amp; payment</a>
              <a href="/privacy">Privacy notice</a>
            </nav>
          </div>
          <div class="footer-column footer-contact" data-reveal>
            <h2>Visit &amp; connect</h2>
            <address class="contact-list">
              <a class="contact-row" href="https://www.google.com/maps/search/?api=1&amp;query=Jalan+Telur%2C+70200+Seremban%2C+Negeri+Sembilan" target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                <span><strong>Our farm</strong>Jalan Telur, 70200 Seremban,<br />Negeri Sembilan<span class="contact-hint">Open in Maps ↗</span></span>
              </a>
              <a class="contact-row" href="tel:+60123456789">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 16.5v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.7 2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7 9.5a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2.1Z" /></svg>
                <span><strong>Call us</strong>+60 12-345 6789</span>
              </a>
              <a class="contact-row" href="https://wa.me/60123456789" target="_blank" rel="noopener noreferrer">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20.5 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20l1.2-4.7a8.5 8.5 0 1 1 16.3-3.8Z" /><path d="M8.2 8.1c.3-.6.6-.6 1-.6h.4c.2 0 .4.1.5.4l.7 1.7c.1.2.1.4-.1.6l-.6.7c-.2.2-.2.4 0 .6.4.7 1 1.3 1.7 1.7.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.7.8c.2.1.3.3.3.5 0 .4-.2 1.1-.7 1.5-.5.4-1.1.6-1.8.4-1-.2-2.2-.8-3.3-1.8-1-.9-1.8-2.1-2-3.1-.2-.9.1-1.8.3-2.4Z" /></svg>
                <span><strong>WhatsApp</strong>Chat with our farm team</span>
              </a>
              <a class="contact-row" href="mailto:yongfarm@gmail.com">
                <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3.5 6 8.5 7 8.5-7" /></svg>
                <span><strong>Email</strong>yongfarm@gmail.com</span>
              </a>
            </address>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Yong Farm. All rights reserved.</p>
          <span>Good eggs, from our farm to your table.</span>
        </div>
      </div>
    </footer>
  </div>
  <script>
    const navigationToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const navigation = document.querySelector<HTMLElement>('#main-nav');
    navigationToggle?.addEventListener('click', () => {
      const expanded = navigationToggle.getAttribute('aria-expanded') === 'true';
      navigationToggle.setAttribute('aria-expanded', String(!expanded));
      navigationToggle.setAttribute('aria-label', expanded ? 'Open navigation' : 'Close navigation');
      navigation?.classList.toggle('is-open', !expanded);
    });
    navigation?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navigationToggle?.setAttribute('aria-expanded', 'false');
        navigationToggle?.setAttribute('aria-label', 'Open navigation');
        navigation?.classList.remove('is-open');
      });
    });
    document.querySelectorAll<HTMLImageElement>('[data-image-fallback]').forEach((image) => {
      image.addEventListener('error', () => {
        const fallback = image.dataset.imageFallback;
        if (fallback && image.src !== new URL(fallback, location.href).href) image.src = fallback;
      }, { once: true });
    });
    const orderProduct = document.querySelector<HTMLSelectElement>('#order-product');
    const orderQuantity = document.querySelector<HTMLInputElement>('#order-quantity');
    const orderUnit = document.querySelector<HTMLSelectElement>('#order-unit');
    const orderEstimate = document.querySelector<HTMLElement>('#order-estimate');
    const orderEstimateDetails = document.querySelector<HTMLElement>('#order-estimate-details');
    const currency = new Intl.NumberFormat('en-MY', { style: 'currency', currency: 'MYR' });
    const updateOrderEstimate = () => {
      const selectedProduct = orderProduct?.selectedOptions[0];
      const priceValue = selectedProduct?.dataset.price;
      const pricePerEgg = Number(priceValue);
      const quantity = Number(orderQuantity?.value);
      const selectedUnit = orderUnit?.selectedOptions[0];
      const eggsPerUnit = Number(selectedUnit?.dataset.eggs);
      if (!priceValue || !Number.isFinite(pricePerEgg) || !Number.isFinite(eggsPerUnit) || eggsPerUnit < 1) {
        if (orderEstimate) orderEstimate.textContent = 'Price on request';
        if (orderEstimateDetails) orderEstimateDetails.textContent = 'We’ll confirm the current price for this product.';
        return;
      }
      if (!Number.isInteger(quantity) || quantity < 1) {
        if (orderEstimate) orderEstimate.textContent = '—';
        if (orderEstimateDetails) orderEstimateDetails.textContent = 'Enter a quantity of at least one to see your estimate.';
        return;
      }
      const eggCount = quantity * eggsPerUnit;
      const total = Math.round(eggCount * pricePerEgg * 100) / 100;
      if (orderEstimate) orderEstimate.textContent = currency.format(total);
      if (orderEstimateDetails) {
        const eggCountText = `${eggCount} ${eggCount === 1 ? 'egg' : 'eggs'}`;
        const unitLabel = selectedUnit?.dataset.unitLabel ?? 'unit';
        const quantityText = eggsPerUnit === 1
          ? eggCountText
          : `${quantity} ${unitLabel}${quantity === 1 ? '' : 's'} · ${eggCountText}`;
        orderEstimateDetails.textContent = `${quantityText} at ${currency.format(pricePerEgg)} per egg`;
      }
    };
    orderProduct?.addEventListener('change', updateOrderEstimate);
    orderQuantity?.addEventListener('input', updateOrderEstimate);
    orderUnit?.addEventListener('change', updateOrderEstimate);
    updateOrderEstimate();
    document.querySelectorAll<HTMLAnchorElement>('[data-order-product]').forEach((link) => {
      link.addEventListener('click', () => {
        const productName = link.dataset.orderProduct;
        if (!productName || !orderProduct) return;
        orderProduct.value = productName;
        updateOrderEstimate();
      });
    });
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove('reveal-pending');
          entry.target.classList.add('reveal-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -35px 0px' });
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((element, index) => {
        element.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
        element.classList.add('reveal-pending');
        revealObserver.observe(element);
      });
    }
  </script>
</BaseLayout>
